{
  "name": "@niradler55/earshot",
  "version": "0.0.3",
  "description": "Real-time Slack message events over your own session — no app, no polling.",
  "type": "module",
  "bin": {
    "earshot": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/gateway.d.ts",
      "default": "./dist/gateway.js"
    },
    "./session": {
      "types": "./dist/extract.d.ts",
      "default": "./dist/extract.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "default": "./dist/webhook.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "token": "bun run src/extract.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build && bun test",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "slack",
    "websocket",
    "realtime",
    "xoxc",
    "no-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niradler/earshot.git"
  },
  "license": "MIT",
  "author": "Nir Adler",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
