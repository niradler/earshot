{
  "name": "@niradler55/earshot",
  "version": "0.0.1",
  "description": "Real-time Slack message events over your own session \u2014 no app, no polling.",
  "type": "module",
  "bin": {
    "earshot": "./bin/earshot.js"
  },
  "exports": {
    ".": "./src/gateway.ts",
    "./session": "./src/extract.ts",
    "./webhook": "./src/webhook.ts"
  },
  "files": [
    "bin",
    "src",
    "!src/*.test.ts"
  ],
  "scripts": {
    "start": "bun run src/cli.ts",
    "token": "bun run src/extract.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "slack",
    "websocket",
    "realtime",
    "xoxc",
    "no-app"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/niradler/earshot.git"
  },
  "license": "MIT",
  "author": "Nir Adler",
  "engines": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "^1.4.5",
    "typescript": "^7.0.2"
  }
}
